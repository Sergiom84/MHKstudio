---
import Layout from '../layouts/Layout.astro';
import { getRoutePath, languages, type Lang } from '../i18n/routes';

const notFoundLabels: Record<Lang, {
  title: string;
  description: string;
  heading: string;
  body: string;
  home: string;
  services: string;
  contact: string;
}> = {
  es: {
    title: 'Página no encontrada',
    description: 'La página que buscas no existe o ha cambiado de dirección.',
    heading: 'Esta página no existe',
    body: 'Puede que la dirección haya cambiado o que el enlace esté incompleto. Desde aquí puedes seguir al inicio, ver los servicios o escribirnos.',
    home: 'Inicio',
    services: 'Servicios',
    contact: 'Contacto',
  },
  en: {
    title: 'Page not found',
    description: 'The page you are looking for does not exist or has moved.',
    heading: 'This page does not exist',
    body: 'The address may have changed or the link may be incomplete. From here you can go to the homepage, see the services or get in touch.',
    home: 'Home',
    services: 'Services',
    contact: 'Contact',
  },
  de: {
    title: 'Seite nicht gefunden',
    description: 'Die gesuchte Seite existiert nicht oder wurde verschoben.',
    heading: 'Diese Seite existiert nicht',
    body: 'Die Adresse hat sich moeglicherweise geaendert oder der Link ist unvollstaendig. Von hier aus gelangen Sie zur Startseite, zu den Leistungen oder zum Kontakt.',
    home: 'Startseite',
    services: 'Leistungen',
    contact: 'Kontakt',
  },
  ru: {
    title: 'Страница не найдена',
    description: 'Запрашиваемая страница не существует или была перемещена.',
    heading: 'Такой страницы нет',
    body: 'Возможно, адрес изменился или ссылка неполная. Отсюда вы можете перейти на главную, посмотреть услуги или связаться с нами.',
    home: 'Главная',
    services: 'Услуги',
    contact: 'Контакты',
  },
  it: {
    title: 'Pagina non trovata',
    description: 'La pagina che cerchi non esiste o e stata spostata.',
    heading: 'Questa pagina non esiste',
    body: 'L indirizzo potrebbe essere cambiato o il link essere incompleto. Da qui puoi tornare alla home, vedere i servizi o scriverci.',
    home: 'Home',
    services: 'Servizi',
    contact: 'Contatto',
  },
  fr: {
    title: 'Page introuvable',
    description: 'La page que vous cherchez n existe pas ou a ete deplacee.',
    heading: 'Cette page n existe pas',
    body: 'L adresse a peut-etre change ou le lien est incomplet. D ici vous pouvez rejoindre l accueil, voir les services ou nous ecrire.',
    home: 'Accueil',
    services: 'Services',
    contact: 'Contact',
  },
};

// Cloudflare Pages sirve un unico /404.html para cualquier ruta, asi que el
// idioma se resuelve en cliente a partir del prefijo de la URL solicitada.
const translations = Object.fromEntries(
  languages.map((language) => [
    language.code,
    {
      ...notFoundLabels[language.code],
      links: {
        home: getRoutePath('home', language.code),
        services: getRoutePath('services', language.code),
        contact: getRoutePath('contact', language.code),
      },
    },
  ])
);

const fallback = translations.es;
---

<Layout
  title={notFoundLabels.es.title}
  description={notFoundLabels.es.description}
  noindex={true}
  lang="es"
>
  <section class="min-h-[60vh] px-6 py-24 flex items-center justify-center bg-[#fdfaf7]">
    <div class="max-w-2xl text-center" data-not-found>
      <p class="text-xs tracking-[0.3em] uppercase text-[#bda589] mb-6">404</p>
      <h1 class="text-4xl md:text-5xl font-light text-[#201400] mb-6" data-nf-heading>
        {fallback.heading}
      </h1>
      <p class="text-lg text-[#201400]/70 leading-relaxed mb-10" data-nf-body>
        {fallback.body}
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href={fallback.links.home}
          data-nf-link="home"
          class="inline-block border border-[#bda589] bg-[#bda589] text-white text-xs tracking-[0.3em] uppercase px-10 py-4 hover:bg-transparent hover:text-[#bda589] transition-all duration-300"
        >
          {fallback.home}
        </a>
        <a
          href={fallback.links.services}
          data-nf-link="services"
          class="inline-block border border-[#bda589] text-[#bda589] text-xs tracking-[0.3em] uppercase px-10 py-4 hover:bg-[#bda589] hover:text-white transition-all duration-300"
        >
          {fallback.services}
        </a>
        <a
          href={fallback.links.contact}
          data-nf-link="contact"
          class="inline-block border border-[#bda589] text-[#bda589] text-xs tracking-[0.3em] uppercase px-10 py-4 hover:bg-[#bda589] hover:text-white transition-all duration-300"
        >
          {fallback.contact}
        </a>
      </div>
    </div>
  </section>
</Layout>

<script is:inline define:vars={{ translations }}>
  (() => {
    const segment = window.location.pathname.split('/')[1];
    const content = translations[segment];

    if (!content) return;

    document.documentElement.lang = segment;

    const heading = document.querySelector('[data-nf-heading]');
    const body = document.querySelector('[data-nf-body]');

    if (heading) heading.textContent = content.heading;
    if (body) body.textContent = content.body;

    document.title = `${content.title} | MHK Studio`;

    for (const key of ['home', 'services', 'contact']) {
      const link = document.querySelector(`[data-nf-link="${key}"]`);
      if (!link) continue;
      link.setAttribute('href', content.links[key]);
      link.textContent = content[key];
    }
  })();
</script>
