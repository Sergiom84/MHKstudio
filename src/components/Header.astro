---
import { siteConfig } from '../data/locations';
import { getLocalizedPath, getRoutePath, getServicePagePath, languages, resolveLocalizedPath, type Lang, type RouteKey } from '../i18n/routes';
import { ui } from '../i18n/content';
import { serviceKeys, servicePagesContent } from '../i18n/servicePages';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const copy = ui[lang];
const currentPath = Astro.url.pathname;
const currentRoute = resolveLocalizedPath(currentPath);
const summaryFlag = lang;

const navLinks: Array<{ label: string; href: string; routeKey: RouteKey }> = [
  { label: copy.nav.home, href: getRoutePath('home', lang), routeKey: 'home' },
  { label: copy.nav.services, href: getRoutePath('services', lang), routeKey: 'services' },
  { label: copy.nav.about, href: getRoutePath('about', lang), routeKey: 'about' },
  { label: copy.nav.contact, href: getRoutePath('contact', lang), routeKey: 'contact' },
];
const serviceNavItems = serviceKeys.map((key) => ({
  label: servicePagesContent[lang][key].navLabel,
  href: getServicePagePath(key, lang),
}));
const isServicesRoute = currentRoute.routeKey === 'services' || currentRoute.routeKey === 'service';
const hasHeaderHeroOverlay =
  currentRoute.routeKey === 'home' ||
  currentRoute.routeKey === 'services' ||
  currentRoute.routeKey === 'about' ||
  currentRoute.routeKey === 'contact';

const socialLinks = [
  {
    label: 'WhatsApp',
    href: siteConfig.whatsapp,
    icon: '<path transform="translate(2 2) scale(0.8333)" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />',
  },
  {
    label: 'Instagram',
    href: siteConfig.instagram,
    icon: '<rect x="4" y="4" width="16" height="16" rx="5" ry="5"></rect><path d="M16.2 11.37a4.2 4.2 0 1 1-8.4 0 4.2 4.2 0 0 1 8.4 0Z"></path><path d="M17.5 6.5h.01"></path>',
  },
  {
    label: 'Facebook',
    href: siteConfig.facebook,
    icon: '<path d="M14 8h2.2V4.4A24.8 24.8 0 0 0 13 4c-3.16 0-5.32 1.93-5.32 5.45V12H4.2v4h3.48v8h4.26v-8h3.34l.53-4h-3.87V9.85C11.94 8.7 12.25 8 14 8Z" />',
  },
  {
    label: 'Pinterest',
    href: siteConfig.pinterest,
    icon: '<path d="M12.04 2.5a9.5 9.5 0 0 0-3.46 18.35c-.08-.79-.16-2 .03-2.86l1.1-4.67s-.28-.57-.28-1.4c0-1.32.76-2.3 1.7-2.3.8 0 1.2.6 1.2 1.33 0 .81-.52 2.03-.79 3.16-.22.94.47 1.7 1.4 1.7 1.68 0 2.98-1.78 2.98-4.34 0-2.27-1.63-3.86-3.96-3.86-2.7 0-4.29 2.02-4.29 4.12 0 .81.31 1.68.7 2.15.08.1.09.18.07.28l-.26 1.06c-.04.17-.14.2-.32.12-1.2-.56-1.95-2.32-1.95-3.74 0-3.04 2.2-5.82 6.35-5.82 3.34 0 5.93 2.38 5.93 5.55 0 3.32-2.1 5.99-5 5.99-.98 0-1.9-.5-2.2-1.1l-.6 2.29c-.22.86-.81 1.93-1.2 2.58A9.5 9.5 0 1 0 12.04 2.5Z" />',
  },
];
---

<header class={`fixed left-0 right-0 top-0 z-50 border-b border-[#201400]/15 ${hasHeaderHeroOverlay ? 'bg-[#f2eadd]/30 backdrop-blur-md' : 'bg-[#fdfaf7]/95 backdrop-blur-sm'}`}>
  <div class="flex h-[72px] w-full items-center justify-between px-6 sm:px-8 lg:h-[92px] lg:px-12 xl:px-16">
    <a href={getRoutePath('home', lang)} class="flex items-center">
      <img src="/images/MHK.webp" alt="MHK Studio" class="h-10 w-auto lg:h-11" loading="eager" />
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden items-center gap-8 lg:flex xl:gap-9">
      {navLinks.map(link => (
        link.routeKey === 'services' ? (
          <div class="nav-services-group relative">
            <a
              href={link.href}
              class={`text-sm font-normal uppercase tracking-[0.12em] text-[#120c00] transition-colors hover:text-[#9a7d62] ${isServicesRoute ? 'text-[#9a7d62]' : ''}`}
            >
              {link.label}
            </a>
            <div class="nav-services-panel absolute left-1/2 top-full z-50 pt-4">
              <div class="min-w-64 border border-[#bda589]/35 bg-[#fdfaf7]/98 p-2 shadow-[0_18px_45px_rgba(32,20,0,0.12)] backdrop-blur-sm">
                {serviceNavItems.map((item) => (
                  <a
                    href={item.href}
                    class="block w-full whitespace-nowrap px-3 py-2 text-left text-xs uppercase tracking-[0.14em] text-[#201400]/75 transition-colors hover:bg-[#bda589]/12 hover:text-[#201400]"
                  >
                    {item.label}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a
            href={link.href}
            class={`text-sm font-normal uppercase tracking-[0.12em] text-[#120c00] transition-colors hover:text-[#9a7d62] ${currentRoute.routeKey === link.routeKey ? 'text-[#9a7d62]' : ''}`}
          >
            {link.label}
          </a>
        )
      ))}
      <details class="language-switcher relative">
        <summary
          class="grid h-8 w-8 cursor-pointer list-none place-items-center text-base leading-none transition-opacity hover:opacity-75"
          aria-label={copy.languageAria}
          title={copy.languages}
        >
          <span class={`language-flag language-flag-${summaryFlag}`} aria-hidden="true"></span>
        </summary>
        <div class="language-switcher-panel absolute right-0 top-[calc(100%+14px)] min-w-44 border border-[#bda589]/35 bg-[#fdfaf7]/98 p-2 shadow-[0_18px_45px_rgba(32,20,0,0.12)] backdrop-blur-sm">
          {languages.map((language) => (
            <a
              href={getLocalizedPath(currentPath, language.code)}
              hreflang={language.hreflang}
              class={`flex w-full items-center gap-3 whitespace-nowrap px-3 py-2 text-left text-xs uppercase tracking-[0.14em] transition-colors hover:bg-[#bda589]/12 hover:text-[#201400] ${language.code === lang ? 'text-[#201400]' : 'text-[#201400]/75'}`}
            >
              <span class={`language-flag language-flag-${language.flag}`} aria-hidden="true"></span>
              <span>{language.label}</span>
            </a>
          ))}
        </div>
      </details>
      <div class="ml-1 flex items-center gap-6">
        {socialLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener"
            aria-label={link.label}
            title={link.label}
            class="grid h-6 w-6 place-items-center text-[#120c00] transition-colors hover:text-[#9a7d62]"
          >
            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
              class="h-5 w-5"
              fill={link.label === 'Instagram' ? 'none' : 'currentColor'}
              stroke={link.label === 'Instagram' ? 'currentColor' : 'none'}
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={link.icon}
            />
          </a>
        ))}
      </div>
    </nav>

    <!-- Mobile burger -->
    <button
      id="menu-toggle"
      type="button"
      class="flex flex-col gap-1.5 p-2 transition-colors lg:hidden"
      aria-label={copy.menuOpen}
      aria-controls="mobile-menu"
      aria-expanded="false"
      data-menu-open-label={copy.menuOpen}
      data-menu-close-label={copy.menuClose}
    >
      <span class="block w-6 h-px bg-[#201400] transition-all"></span>
      <span class="block w-6 h-px bg-[#201400] transition-all"></span>
      <span class="block w-6 h-px bg-[#201400] transition-all"></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden border-t border-[#201400]/15 bg-[#fdfaf7]/95 px-6 pb-6 lg:hidden">
    <nav class="flex flex-col gap-4 pt-4">
      {navLinks.map(link => (
        <>
          <a
            href={link.href}
            class={`text-sm tracking-widest uppercase font-light hover:text-[#bda589] transition-colors ${(link.routeKey === 'services' ? isServicesRoute : currentRoute.routeKey === link.routeKey) ? 'text-[#bda589]' : 'text-[#201400]'}`}
          >
            {link.label}
          </a>
          {link.routeKey === 'services' && (
            <div class="ml-3 flex flex-col gap-3 border-l border-[#bda589]/35 pl-4">
              {serviceNavItems.map((item) => (
                <a
                  href={item.href}
                  class="text-xs uppercase tracking-[0.14em] font-light text-[#201400]/75 transition-colors hover:text-[#bda589]"
                >
                  {item.label}
                </a>
              ))}
            </div>
          )}
        </>
      ))}
      <div class="mt-2 border-t border-[#bda589]/30 pt-4">
        <p class="mb-3 text-xs uppercase tracking-[0.22em] text-[#bda589]">{copy.languages}</p>
        <div class="flex flex-wrap gap-2">
          {languages.map((language) => (
            <a
              href={getLocalizedPath(currentPath, language.code)}
              hreflang={language.hreflang}
              class={`inline-flex items-center gap-2 rounded-full border border-[#bda589]/45 px-3 py-2 text-xs uppercase tracking-[0.12em] ${language.code === lang ? 'text-[#201400]' : 'text-[#201400]/75'}`}
            >
              <span class={`language-flag language-flag-${language.flag}`} aria-hidden="true"></span>
              <span>{language.label}</span>
            </a>
          ))}
        </div>
      </div>
      <div class="flex items-center gap-5 pt-2">
        {socialLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener"
            aria-label={link.label}
            title={link.label}
            class="grid h-8 w-8 place-items-center text-[#201400]"
          >
            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
              class="h-5 w-5"
              fill={link.label === 'Instagram' ? 'none' : 'currentColor'}
              stroke={link.label === 'Instagram' ? 'currentColor' : 'none'}
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={link.icon}
            />
          </a>
        ))}
      </div>
    </nav>
  </div>
</header>

<style>
  .nav-services-panel {
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 6px);
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

  .nav-services-group:hover .nav-services-panel,
  .nav-services-group:focus-within .nav-services-panel {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const languageSwitchers = document.querySelectorAll('.language-switcher');

  const closeLanguageSwitchers = () => {
    languageSwitchers.forEach((switcher) => {
      if (switcher instanceof HTMLDetailsElement) switcher.open = false;

      if (document.activeElement instanceof HTMLElement && switcher.contains(document.activeElement)) {
        document.activeElement.blur();
      }
    });
  };

  const setMenuOpen = (open) => {
    menu?.classList.toggle('hidden', !open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute(
      'aria-label',
      open ? toggle?.dataset.menuCloseLabel ?? 'Close menu' : toggle?.dataset.menuOpenLabel ?? 'Open menu'
    );
  };

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    setMenuOpen(!isOpen);
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Node)) return;

    const clickedInsideLanguageSwitcher = Array.from(languageSwitchers).some((switcher) =>
      switcher.contains(event.target)
    );

    if (!clickedInsideLanguageSwitcher) {
      closeLanguageSwitchers();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      setMenuOpen(false);
      closeLanguageSwitchers();
    }
  });
</script>
