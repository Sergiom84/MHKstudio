---
import Layout from '../../layouts/Layout.astro';
import ReviewsCarousel from './ReviewsCarousel.astro';
import { siteConfig } from '../../data/locations';
import { servicesContent, ui } from '../../i18n/content';
import { servicePagesContent, type ServiceKey } from '../../i18n/servicePages';
import { absoluteUrl, getRoutePath, getServicePagePath, type Lang } from '../../i18n/routes';

interface Props {
  lang: Lang;
  serviceKey: ServiceKey;
}

const { lang, serviceKey } = Astro.props;
const copy = ui[lang];
const content = servicePagesContent[lang][serviceKey];
const loadingForm = servicesContent[lang].loadingForm;
const canonicalPath = getServicePagePath(serviceKey, lang);
const canonical = absoluteUrl(siteConfig.url, canonicalPath);
const homePath = getRoutePath('home', lang);

const linkifyBrand = (paragraph: string) => paragraph.split('MHK Studio');

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonical}#webpage`,
      "url": canonical,
      "name": content.metaTitle,
      "description": content.metaDescription,
      "isPartOf": { "@id": `${siteConfig.url}/#website` },
      "about": { "@id": `${siteConfig.url}/#organization` },
      "inLanguage": lang
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonical}#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": copy.nav.home, "item": absoluteUrl(siteConfig.url, homePath) },
        { "@type": "ListItem", "position": 2, "name": copy.nav.services, "item": absoluteUrl(siteConfig.url, getRoutePath('services', lang)) },
        { "@type": "ListItem", "position": 3, "name": content.h1, "item": canonical }
      ]
    },
    {
      "@type": "Service",
      "@id": `${canonical}#service`,
      "name": content.h1,
      "description": content.metaDescription,
      "provider": { "@id": `${siteConfig.url}/#organization` },
      "areaServed": "Almería"
    }
  ]
};
---

<Layout title={content.metaTitle} description={content.metaDescription} canonical={canonical} schema={schema} lang={lang} noHeaderOffset={true}>
  <section class="services-hero relative flex min-h-[48vh] items-center justify-center overflow-hidden bg-[#d4c0ab] px-6 py-20 text-center md:min-h-[56vh]">
    <img
      src="/images/PortadaServicio.png"
      alt={content.h1}
      class="absolute inset-0 h-full w-full scale-[1.04] object-cover blur-[5px]"
      loading="eager"
    />
    <div class="absolute inset-0 bg-[#fdfaf7]/30"></div>
    <div class="relative z-10 mx-auto max-w-6xl">
      <p class="mb-4 text-xs uppercase tracking-[0.4em] text-[#201400]/70">{siteConfig.tagline}</p>
      <h1 class="page-hero-title text-[#201400]">
        {content.h1}
      </h1>
    </div>
  </section>

  <section class="border-b border-[#bda589]/35 bg-white px-6 pb-16 pt-20 md:pt-24">
    <div class="mx-auto max-w-4xl">
      {content.intro.map((paragraph, index) => (
        <p class={`${index > 0 ? 'mt-6' : ''} home-uniform-body mhk-body-reference text-[#201400]/80`}>
          {index === 0
            ? linkifyBrand(paragraph).map((part, partIndex) => (
                <>
                  {partIndex > 0 && (
                    <a href={homePath} class="text-[#b58f73] transition-colors hover:text-[#9a7d62] hover:underline">MHK Studio</a>
                  )}
                  {part}
                </>
              ))
            : paragraph}
        </p>
      ))}
    </div>
  </section>

  {content.sections.map((section, index) => (
    <section class={`relative overflow-hidden px-6 py-16 md:py-20 ${index % 2 === 0 ? 'bg-[#fdfaf7]' : 'bg-white'}`}>
      <div class="mx-auto max-w-4xl">
        <h2 class="services-detail-heading mb-7 text-3xl font-light leading-tight text-[#201400] md:text-4xl">{section.heading}</h2>

        {section.paragraphs?.map((paragraph) => (
          <p class="home-uniform-body mhk-body-reference mt-5 text-[#201400]/80">{paragraph}</p>
        ))}

        {section.lead && (
          <p class="home-uniform-body mhk-body-reference mt-5 text-[#201400]/80">{section.lead}</p>
        )}

        {section.items && (
          <div class="mt-8 grid gap-7 md:grid-cols-2">
            {section.items.map((item) => (
              <div class="flex gap-3">
                <span class="mt-[0.62em] h-2 w-2 shrink-0 rounded-full bg-[#bda589]"></span>
                <div>
                  <h3 class="mb-2 text-lg font-medium leading-snug text-[#201400]">{item.title}</h3>
                  <p class="home-uniform-body mhk-body-reference text-[#201400]/75">{item.text}</p>
                </div>
              </div>
            ))}
          </div>
        )}

        {section.bullets && (
          <ul class="home-uniform-body mhk-body-reference mt-7 grid gap-3 text-[#201400]/75">
            {section.bullets.map((item) => (
              <li class="flex items-start gap-3">
                <span class="mt-[0.58em] h-2 w-2 shrink-0 rounded-full bg-[#bda589]"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        )}

        {section.closing && (
          <p class="home-uniform-body mhk-body-reference mt-8 border-l-2 border-[#bda589] pl-5 italic text-[#9a7d62]">{section.closing}</p>
        )}
      </div>
      {index === 0 && (
        <img src="/images/Circulo.webp" alt="" class="absolute -right-10 -top-10 h-28 w-28 rotate-45 opacity-60" aria-hidden="true" />
      )}
    </section>
  ))}

  <ReviewsCarousel lang={lang} />

  <section id="solicitar-asesoria" class="bg-[#bda589] px-6 py-24">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="mb-6 text-3xl font-light text-white md:text-4xl">{content.ctaHeading}</h2>
      {content.ctaParagraphs.map((paragraph, index) => (
        <p class={`mhk-body-reference text-white/85 ${index === content.ctaParagraphs.length - 1 ? 'mb-10' : 'mb-5'}`}>{paragraph}</p>
      ))}
      <a href={siteConfig.whatsapp} target="_blank" rel="noopener" class="inline-block w-full border border-white/70 px-10 py-4 text-center text-xs uppercase text-white transition-all duration-300 hover:bg-white hover:text-[#201400] sm:w-auto">
        {copy.actions.whatsapp}
      </a>
      <div class="mt-8 w-full rounded-[8px] bg-[#fdfaf7] p-5 text-left text-[#201400] shadow-[0_18px_45px_rgba(32,20,0,0.14)] md:p-8">
        <p data-hubspot-loading class="text-sm leading-relaxed text-[#201400]/65">{loadingForm}</p>
        <div id="mhk-hubspot-service-form" class="hbspt-form"></div>
      </div>
    </div>
  </section>

  <section class="relative h-20 overflow-hidden bg-[#201400]">
    <div class="absolute -right-16 top-12 opacity-20">
      <img src="/images/Circulo.webp" alt="" class="h-48 w-48 rotate-45" aria-hidden="true" />
    </div>
  </section>

  <script is:inline src="https://js.hsforms.net/forms/embed/v2.js"></script>
  <script is:inline>
    (() => {
      const formTarget = document.getElementById('mhk-hubspot-service-form');
      const loadingMessage = document.querySelector('[data-hubspot-loading]');
      let formLoaded = false;

      const loadHubSpotForm = (attempt = 0) => {
        if (formLoaded || !formTarget) return;

        if (!window.hbspt?.forms) {
          if (attempt < 20) window.setTimeout(() => loadHubSpotForm(attempt + 1), 150);
          return;
        }

        formLoaded = true;
        loadingMessage?.remove();
        window.hbspt.forms.create({
          portalId: '49385837',
          formId: 'f07fd6a8-686f-4879-9230-7ba46a86744c',
          region: 'na1',
          target: '#mhk-hubspot-service-form',
        });
      };

      loadHubSpotForm();
    })();
  </script>
</Layout>
